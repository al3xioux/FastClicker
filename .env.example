# Copier en .env et remplacer les valeurs.
# Ces mêmes noms sont lus par le conteneur Postgres, par l'API des scores,
# et plus tard par le service de stats en Python.

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=un-utilisateur
POSTGRES_PASSWORD=un-mot-de-passe
POSTGRES_DB=un-nom-de-base

# Port d'écoute de l'API des scores dans son conteneur
PORT=3000

# Ports publiés sur la machine
GAME_PORT=8080
SCORES_API_PORT=3000
ADMINER_PORT=8081
